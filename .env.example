# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n lead follow-up workflow
# Server-only. Do NOT prefix with NEXT_PUBLIC_ or the secret ships to the browser.
# N8N_FOLLOWUP_SECRET must match FOLLOWUP_SHARED_SECRET in the
# "Check Secret & Normalize" node of the on-demand follow-up workflow.
N8N_FOLLOWUP_WEBHOOK_URL=https://your-n8n-host/webhook/lead-followup
N8N_FOLLOWUP_SECRET=a-long-random-string
